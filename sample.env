# ---- Zaroori (required) ----
API_ID=1234567
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your_bot_token_here

# Apni Telegram user id (kai admin ho to space se alag karo)
ADMINS=123456789

# Channel ids (-100 se shuru hoti hain)
SOURCE_CHANNEL=-1001234567890
TARGET_CHANNEL=-1009876543210

# ---- Optional ----
# true = source me nayi file aate hi apne aap target me chali jaye
AUTO_FORWARD=true

# CLEAN_CAPTION=true: caption se @username aur telegram links hatao (file re-upload nahi hoti, fast)
# CLEAN_FILENAME=true: file ka naam saaf hoga (jinke naam me username hai unhi ko re-upload lagega, baaki seedha copy)
CLEAN_CAPTION=true
CLEAN_FILENAME=true
SET_POSTER=false

# SET_POSTER=true karne par zaroori (themoviedb.org se free key)
TMDB_API_KEY=

# Ye naam file ke naam/caption me kahin bhi mile (@ ke saath ya bina) to hat jayega
BLOCK_WORDS=ClipmateMovies
