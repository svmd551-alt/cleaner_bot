from pathlib import Path

content = """# ROAROIC File Share Bot - .env template
# Replace every CHANGE_ME value before running.
# Keep this file private; never share your API_HASH, BOT_TOKEN, or USER_SESSION.

API_ID=CHANGE_ME
API_HASH=CHANGE_ME
BOT_TOKEN=CHANGE_ME

# Telegram channel IDs (usually -100xxxxxxxxxx)
SOURCE_CHANNEL=-100CHANGE_ME
TARGET_CHANNEL=-100CHANGE_ME

# Optional: route CAM/TS/TC quality files to a separate channel; leave blank to disable
QUALITY_TARGET_CHANNEL=

# Telegram numeric user IDs allowed to use admin commands; comma-separated
ADMINS=123456789

# Forwarding / retry settings
AUTO_RESUME=true
MAX_AUTO_RESUMES=0
RETRY_ROUNDS=4
MAX_RETRIES=5
WORKERS=3
PREFETCH=3
TRANSMISSIONS=8
TG_WORKERS=8
SEND_DELAY=1.0
FLOOD_MAX_DELAY=5.0
COOLDOWN_AFTER=8
SHUTDOWN_WAIT=20
SILENT=true
LIVE_PANEL=true
STARTUP_NOTIFY=true

# Caption and file processing defaults
CLEAN_CAPTION=true
CLEAN_FILENAME=true
DEDUPE=true
AUTO_FORWARD=true
NOTIFY=true
DELETE_QUALITY=false
AUTO_CAPTION=false
HD_POSTER=false
SET_POSTER=false
NAME_FROM_POSTER=false
FRAME_THUMB=true
FRAME_AT=0.1

# Optional words/domains to remove from captions or filenames (comma-separated)
BLOCK_WORDS=
EXTRA_LINK_DOMAINS=

# Optional TMDB poster/caption support
TMDB_API_KEY=
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
OCR_MIN_SCORE=0.8

# Optional OCR.space key (needed only if using poster OCR and Tesseract is unavailable)
OCR_SPACE_KEY=

# Optional premium user session for larger files; leave blank if unused
USER_SESSION=
USER_MAX_MB=3990
MAX_UPLOAD_MB=1990

# Runtime / Render
PORT=8080
RENDER_EXTERNAL_URL=
STATE_FILE=bot_state.json
"""
path = Path("/mnt/data/roaroic.env.example")
path.write_text(content, encoding="utf-8")
print(f"Created: {path}")
